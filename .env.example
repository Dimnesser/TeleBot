# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# --- откуда брать модель ---
# anthropic | gemini | groq | openrouter | custom
# gemini и groq имеют бесплатный тариф, anthropic требует платных кредитов
AI_PROVIDER=anthropic

# Ключ выбранного провайдера. Заполняется только нужная строка.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Модель. Пусто — берётся значение по умолчанию для провайдера.
# У openrouter и custom задать обязательно.
AI_MODEL=

# Адрес сервера для AI_PROVIDER=custom, например локальной Ollama
AI_BASE_URL=

# --- модель Anthropic ---
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — глубина рассуждений
CLAUDE_EFFORT=medium
CLAUDE_MAX_TOKENS=8000
CLAUDE_TIMEOUT_SECONDS=180

# --- инструменты ---
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=5
ENABLE_REFUSAL_FALLBACK=true

# --- память диалога ---
HISTORY_TURNS=20
HISTORY_MAX_CHARS=40000
# Путь к файлу, чтобы контекст переживал перезапуск. Пусто — только в памяти.
HISTORY_FILE=data/history.json

# --- доступ ---
# Пусто — отвечать всем. Иначе список Telegram ID через запятую.
ALLOWED_USER_IDS=

# --- разное ---
MAX_IMAGE_BYTES=5242880
MAX_DOCUMENT_BYTES=204800
LOG_LEVEL=INFO
