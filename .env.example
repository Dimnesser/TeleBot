# Токен бота от @BotFather
BOT_TOKEN=

# ID администраторов через запятую (Telegram user id, не username)
ADMIN_IDS=

# Чат/канал, куда падают заявки на депозит для модерации (id чата, бот должен быть его участником)
ADMIN_CHAT_ID=

# Хранилище (по умолчанию — локальный SQLite-файл)
DATABASE_URL=sqlite+aiosqlite:///./data/brainrot_battle.db

# Курс начисления: сколько B выдаётся за 1 Telegram Star
STARS_TO_BALANCE_RATE=1

# Ограничения на сумму пополнения через Stars
MIN_STARS_AMOUNT=50
MAX_STARS_AMOUNT=100000

# Сколько заявок на трейд предметами может обрабатываться одновременно —
# при превышении показывается экран «Депозит временно недоступен» и очередь
MAX_CONCURRENT_TRADES=5
# Среднее время обработки одного трейда (минуты) — используется для оценки времени ожидания в очереди
AVG_TRADE_MINUTES=8

# Демо-валюта игровых разделов (кейсы и т.п.) — НЕ связана с депозитами и выводом.
DEMO_STARTING_TOKENS=2000
DEMO_TOPUP_TOKENS=1000

# Апгрейдер: границы, в которые всегда попадает шанс успеха (без 0%/100%)
UPGRADER_MIN_CHANCE_PERCENT=1
# Mini App: цели апгрейдера — только с честным шансом от этого порога вниз до 1%
UPGRADER_MAX_TARGET_CHANCE_PERCENT=75
UPGRADER_MAX_CHANCE_PERCENT=95

# Краш: тик анимации (сек), скорость роста множителя за тик, safety-cap по времени раунда
CRASH_TICK_SECONDS=1.2
CRASH_GROWTH_RATE=0.07
CRASH_MAX_DURATION_SECONDS=30
CRASH_HOUSE_EDGE=0.97
CRASH_MAX_MULTIPLIER=100

# Дайсы: шанс отдельного бонус-события (rainbow, x10) поверх таблицы совпадений
DICE_BONUS_CHANCE_PERCENT=3
DICE_BONUS_MULTIPLIER=10

LOG_LEVEL=INFO

# Mini App (webapp/): бот и Mini App работают в одном процессе (см. bot/app.py).
# WEBAPP_URL — публичный https-адрес, на котором доступен Mini App (например,
# ngrok-туннель на локальный WEBAPP_PORT). Пока не задан — кнопка
# «🎮 ОТКРЫТЬ MINI APP» в боте не показывается (Telegram принимает web_app
# только на https). См. webapp/README.md.
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Небезопасный обход проверки initData для локальной отладки в обычном
# браузере — включать только на localhost, никогда на адресе, пробрасываемом
# наружу (ngrok и т.п.).
WEBAPP_ALLOW_DEV_AUTH=false
